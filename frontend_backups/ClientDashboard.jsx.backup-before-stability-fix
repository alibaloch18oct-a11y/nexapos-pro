import React, { useEffect, useMemo, useState } from "react";
import { api } from "../lib/api";

const mainButtons = [
  {
    number: 1,
    key: "walk_in",
    name: "Walk In",
    icon: "🚶",
    bg: "linear-gradient(135deg,#18181b,#020617)",
    animClass: "mode-anim-walk"
  },
  {
    number: 2,
    key: "take_away",
    name: "Take Away",
    icon: "🛍️",
    bg: "linear-gradient(135deg,#38bdf8,#2563eb)",
    animClass: "mode-anim-bag"
  },
  {
    number: 3,
    key: "delivery",
    name: "Delivery",
    icon: "🛵",
    bg: "linear-gradient(135deg,#fde047,#f97316)",
    animClass: "mode-anim-delivery"
  },
  {
    number: 4,
    key: "dine_in",
    name: "Dine In",
    icon: "🍽️",
    bg: "linear-gradient(135deg,#fb7185,#ef4444)",
    animClass: "mode-anim-dine"
  },
  {
    number: 5,
    key: "drive_thru",
    name: "Drive Thru",
    icon: "🚗",
    bg: "linear-gradient(135deg,#4ade80,#16a34a)",
    animClass: "mode-anim-drive"
  },
  {
    number: 6,
    key: "kiosk",
    name: "Kiosk",
    icon: "☝️",
    bg: "linear-gradient(135deg,#ffe4e6,#f9a8d4)",
    animClass: "mode-anim-kiosk"
  }
];

const dockButtons = [
  { key: "orders", openKey: "orders", name: "Orders", icon: "📋", bg: "linear-gradient(135deg,#d1d5db,#94a3b8)" },
  { key: "dispatch", openKey: "drive_thru_queue", name: "Dispatch", icon: "📍", bg: "linear-gradient(135deg,#22c55e,#14b8a6)" },
  { key: "attendance", openKey: "staff", name: "Attendance", icon: "🕘", bg: "linear-gradient(135deg,#f472b6,#a855f7)" },
  { key: "staff", openKey: "staff", name: "Staff", icon: "👥", bg: "linear-gradient(135deg,#bae6fd,#60a5fa)" },
  { key: "cashier", openKey: "staff", name: "Cashier", icon: "💳", bg: "linear-gradient(135deg,#ccfbf1,#5eead4)" },
  { key: "kds", openKey: "kds", name: "KDS", icon: "🖥️", bg: "linear-gradient(135deg,#94a3b8,#475569)" },
  { key: "reports", openKey: "analytics", name: "Reports", icon: "📈", bg: "linear-gradient(135deg,#ffffff,#c4b5fd)" },
  { key: "printer", openKey: "restaurant_settings", name: "Printer", icon: "🖨️", bg: "linear-gradient(135deg,#111827,#64748b)" },
  { key: "settings", openKey: "settings", name: "Settings", icon: "⚙️", bg: "linear-gradient(135deg,#334155,#020617)" }
];

function formatMoney(value) {
  return `Rs ${Math.round(Number(value || 0)).toLocaleString()}`;
}

export default function ClientDashboard({ token, session, onOpenModule }) {
  const [stats, setStats] = useState({
    todaySales: 0,
    todayOrders: 0,
    activeTables: 0,
    pendingKitchenOrders: 0,
    lowStockItems: 0,
    activeStaff: 0
  });
  const [clock, setClock] = useState(new Date());

  useEffect(() => {
    const t = setInterval(() => setClock(new Date()), 1000 * 30);
    return () => clearInterval(t);
  }, []);

  async function loadStats() {
    try {
      const res = await api(token).get("/api/client/dashboard");
      setStats(res.data.stats || {});
    } catch {
      setStats({
        todaySales: 0,
        todayOrders: 0,
        activeTables: 0,
        pendingKitchenOrders: 0,
        lowStockItems: 0,
        activeStaff: 0
      });
    }
  }

  useEffect(() => {
    loadStats();
  }, []);

  function openMainMode(item) {
    onOpenModule({
      key: item.key,
      modeKey: item.key,
      name: item.name
    });
  }

  function openDock(item) {
    onOpenModule({
      key: item.openKey,
      name: item.name
    });
  }

  const topStats = useMemo(
    () => [
      { label: "Today Sales", value: formatMoney(stats.todaySales) },
      { label: "Orders", value: stats.todayOrders || 0 },
      { label: "Tables", value: stats.activeTables || 0 },
      { label: "Kitchen", value: stats.pendingKitchenOrders || 0 }
    ],
    [stats]
  );

  return (
    <div className="epos-shell">
      <style>
        {`
          .epos-shell {
            min-height: calc(100vh - 72px);
            padding: 18px 26px 16px;
            display: grid;
            grid-template-rows: auto 1fr auto;
            gap: 14px;
            position: relative;
            overflow: hidden;
            background:
              radial-gradient(circle at 12% 25%, rgba(91,33,182,.95), transparent 30%),
              radial-gradient(circle at 82% 18%, rgba(236,72,153,.78), transparent 35%),
              radial-gradient(circle at 55% 68%, rgba(99,102,241,.72), transparent 38%),
              linear-gradient(135deg, #581c87 0%, #7e22ce 34%, #db2777 66%, #4c1d95 100%);
          }

          .epos-shell::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
              linear-gradient(125deg, transparent 0 18%, rgba(255,255,255,.08) 19% 24%, transparent 25% 100%),
              linear-gradient(35deg, transparent 0 42%, rgba(255,255,255,.08) 43% 48%, transparent 49% 100%);
            pointer-events: none;
          }

          .epos-topbar {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: 330px 1fr 350px;
            gap: 16px;
            align-items: center;
          }

          .epos-panel {
            border-radius: 28px;
            background: rgba(15,23,42,.24);
            border: 1px solid rgba(255,255,255,.12);
            box-shadow: 0 22px 50px rgba(0,0,0,.20);
            backdrop-filter: blur(18px);
          }

          .epos-sync {
            display: grid;
            grid-template-columns: 82px 1fr;
            min-height: 106px;
            overflow: hidden;
          }

          .epos-sync-left {
            background: rgba(255,255,255,.94);
            display: grid;
            place-items: center;
            color: #15803d;
            font-weight: 950;
            text-align: center;
          }

          .epos-sync-right {
            padding: 17px 19px;
            color: white;
          }

          .epos-sync-time {
            font-size: 32px;
            font-weight: 950;
            line-height: 1;
            text-shadow: 0 4px 10px rgba(0,0,0,.35);
          }

          .epos-sync-date {
            margin-top: 10px;
            font-size: 20px;
            font-weight: 800;
          }

          .epos-center-welcome {
            padding: 6px 8px;
            text-align: center;
            color: white;
          }

          .epos-center-title {
            font-size: 40px;
            font-weight: 1000;
            letter-spacing: -.05em;
            text-shadow: 0 8px 18px rgba(0,0,0,.35);
            margin: 0;
          }

          .epos-stats-row {
            margin-top: 10px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
          }

          .epos-stat-chip {
            border-radius: 16px;
            padding: 9px 11px;
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.11);
          }

          .epos-stat-chip p {
            margin: 0;
          }

          .epos-stat-label {
            color: rgba(255,255,255,.75);
            font-size: 12px;
            font-weight: 700;
          }

          .epos-stat-value {
            color: white;
            margin-top: 4px !important;
            font-size: 17px;
            font-weight: 950;
          }

          .epos-user {
            min-height: 106px;
            display: grid;
            grid-template-columns: 60px 1fr 58px;
            align-items: center;
            gap: 12px;
            padding: 14px;
          }

          .epos-avatar,
          .epos-bell {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: rgba(255,255,255,.95);
            font-size: 27px;
            position: relative;
          }

          .epos-bell-dot {
            position: absolute;
            top: -4px;
            right: -4px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #ef4444;
            color: white;
            font-size: 12px;
            font-weight: 900;
          }

          .epos-branch {
            width: 100%;
            height: 44px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.14);
            background: rgba(255,255,255,.16);
            color: white;
            padding: 0 14px;
            font-size: 16px;
            outline: none;
          }

          .epos-branch option {
            color: #111827;
          }

          .epos-main {
            position: relative;
            z-index: 2;
            display: grid;
            place-items: center;
            padding: 0;
          }

          .epos-main-grid {
            width: min(1220px, 100%);
            display: grid;
            grid-template-columns: repeat(4, minmax(180px, 1fr));
            gap: 24px 42px;
            justify-items: center;
          }

          .epos-main-cell {
            position: relative;
          }

          .epos-main-cell.center-bottom-left {
            grid-column: 2 / 3;
          }

          .epos-main-cell.center-bottom-right {
            grid-column: 3 / 4;
          }

          .epos-mode-wrap {
            display: grid;
            justify-items: center;
          }

          .epos-mode-btn {
            width: 226px;
            height: 178px;
            border: 0;
            border-radius: 28px;
            position: relative;
            cursor: pointer;
            box-shadow: 0 22px 44px rgba(0,0,0,.25);
            transition: .22s ease;
            overflow: hidden;
          }

          .epos-mode-btn::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(255,255,255,.10), transparent 50%, rgba(255,255,255,.06));
            pointer-events: none;
          }

          .epos-mode-btn:hover {
            transform: translateY(-8px) scale(1.02);
            filter: brightness(1.04);
          }

          .epos-mode-badge {
            position: absolute;
            top: 10px;
            left: 12px;
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: rgba(255,255,255,.92);
            color: #4338ca;
            display: grid;
            place-items: center;
            font-weight: 950;
            font-size: 16px;
            z-index: 4;
          }

          .epos-mode-icon {
            width: 100%;
            height: 100%;
            display: grid;
            place-items: center;
            font-size: 88px;
            position: relative;
            z-index: 2;
          }

          .epos-mode-title {
            margin-top: 10px;
            color: white;
            font-size: 24px;
            font-weight: 950;
            text-shadow: 0 4px 10px rgba(0,0,0,.55);
          }

          .epos-mode-sub {
            display: none;
          }

          .mode-anim-walk { animation: walkFloat 1.1s ease-in-out infinite; }
          .mode-anim-bag { animation: bagSwing 1.6s ease-in-out infinite; }
          .mode-anim-delivery { animation: deliveryMove 1.35s ease-in-out infinite; }
          .mode-anim-dine { animation: dinePulse 1.7s ease-in-out infinite; }
          .mode-anim-drive { animation: driveShift 1.2s ease-in-out infinite; }
          .mode-anim-kiosk { animation: tapBounce 1.2s ease-in-out infinite; }

          @keyframes walkFloat {
            0%,100% { transform: translateX(0) translateY(0) rotate(0deg); }
            25% { transform: translateX(-4px) translateY(-1px) rotate(-5deg); }
            50% { transform: translateX(4px) translateY(0) rotate(3deg); }
            75% { transform: translateX(-2px) translateY(-1px) rotate(-3deg); }
          }

          @keyframes bagSwing {
            0%,100% { transform: rotate(0deg) translateY(0); }
            25% { transform: rotate(-7deg) translateY(-4px); }
            50% { transform: rotate(6deg) translateY(0); }
            75% { transform: rotate(-4deg) translateY(-2px); }
          }

          @keyframes deliveryMove {
            0%,100% { transform: translateX(0); }
            40% { transform: translateX(6px); }
            70% { transform: translateX(-4px); }
          }

          @keyframes dinePulse {
            0%,100% { transform: scale(1); }
            50% { transform: scale(1.08); }
          }

          @keyframes driveShift {
            0%,100% { transform: translateX(0); }
            30% { transform: translateX(6px); }
            60% { transform: translateX(-3px); }
          }

          @keyframes tapBounce {
            0%,100% { transform: scale(1) translateY(0); }
            40% { transform: scale(1.08) translateY(-4px); }
            70% { transform: scale(.98) translateY(0); }
          }

          .epos-dock {
            position: relative;
            z-index: 2;
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            padding: 4px 12px 0;
          }

          .epos-dock-item {
            width: 82px;
            border: 0;
            background: transparent;
            color: white;
            display: grid;
            justify-items: center;
            gap: 7px;
            cursor: pointer;
            transition: .2s ease;
          }

          .epos-dock-item:hover {
            transform: translateY(-6px);
          }

          .epos-dock-icon {
            width: 66px;
            height: 66px;
            border-radius: 18px;
            display: grid;
            place-items: center;
            font-size: 31px;
            box-shadow: 0 18px 28px rgba(0,0,0,.20);
            border: 1px solid rgba(255,255,255,.24);
          }

          .epos-dock-label {
            font-size: 14px;
            font-weight: 900;
            text-shadow: 0 4px 10px rgba(0,0,0,.6);
          }

          .epos-dock-divider {
            width: 1px;
            height: 66px;
            background: rgba(255,255,255,.28);
            margin: 0 4px;
            align-self: center;
          }

          @media (max-width: 1280px) {
            .epos-shell {
              overflow-y: auto;
            }

            .epos-topbar {
              grid-template-columns: 1fr;
            }

            .epos-center-title {
              font-size: 36px;
            }

            .epos-main-grid {
              grid-template-columns: repeat(2, minmax(180px, 1fr));
              gap: 28px;
            }

            .epos-main-cell.center-bottom-left,
            .epos-main-cell.center-bottom-right {
              grid-column: auto;
            }
          }

          @media (max-width: 760px) {
            .epos-shell {
              padding: 12px;
            }

            .epos-main-grid {
              grid-template-columns: 1fr;
            }

            .epos-mode-btn {
              width: 100%;
              max-width: 280px;
            }

            .epos-stats-row {
              grid-template-columns: repeat(2, 1fr);
            }
          }
        `}
      </style>

      <div className="epos-topbar">
        <div className="epos-panel epos-sync">
          <div className="epos-sync-left">
            <div>
              <div style={{ fontSize: 28 }}>📡</div>
              <div>Connected</div>
              <div>0</div>
            </div>
          </div>

          <div className="epos-sync-right">
            <div className="epos-sync-time">
              {clock.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}
            </div>
            <div className="epos-sync-date">
              {clock.toLocaleDateString([], {
                weekday: "long",
                month: "short",
                day: "numeric"
              })}
            </div>
          </div>
        </div>

        <div className="epos-center-welcome">
          <h1 className="epos-center-title">
            Welcome {session?.tenant?.restaurantName || session?.user?.username || "Restaurant"}
          </h1>

          <div className="epos-stats-row">
            {topStats.map((item) => (
              <div className="epos-stat-chip" key={item.label}>
                <p className="epos-stat-label">{item.label}</p>
                <p className="epos-stat-value">{item.value}</p>
              </div>
            ))}
          </div>
        </div>

        <div className="epos-panel epos-user">
          <div className="epos-avatar">👤</div>

          <div>
            <div style={{ color: "white", fontWeight: 900, marginBottom: 8 }}>
              {session?.user?.username || "Client User"}
            </div>
            <select className="epos-branch" defaultValue="main">
              <option value="main">{session?.tenant?.restaurantName || "Main Branch"}</option>
              <option value="branch2">Branch 2</option>
              <option value="branch3">Branch 3</option>
            </select>
          </div>

          <div className="epos-bell">
            🔔
            <div className="epos-bell-dot">1</div>
          </div>
        </div>
      </div>

      <div className="epos-main">
        <div className="epos-main-grid">
          {mainButtons.map((item, index) => {
            const placementClass =
              index === 4
                ? "center-bottom-left"
                : index === 5
                ? "center-bottom-right"
                : "";

            return (
              <div className={`epos-main-cell ${placementClass}`} key={item.key}>
                <div className="epos-mode-wrap">
                  <button
                    className="epos-mode-btn"
                    style={{ background: item.bg }}
                    onClick={() => openMainMode(item)}
                  >
                    <div className="epos-mode-badge">{item.number}</div>

                    <div className={`epos-mode-icon ${item.animClass}`}>
                      {item.icon}
                    </div>
                  </button>

                  <div className="epos-mode-title">{item.name}</div>
                  <div className="epos-mode-sub">Open selling mode</div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div className="epos-dock">
        {dockButtons.map((item, index) => (
          <React.Fragment key={item.key}>
            {index === 8 ? <div className="epos-dock-divider" /> : null}

            <button className="epos-dock-item" onClick={() => openDock(item)}>
              <div className="epos-dock-icon" style={{ background: item.bg }}>
                {item.icon}
              </div>
              <div className="epos-dock-label">{item.name}</div>
            </button>
          </React.Fragment>
        ))}
      </div>
    </div>
  );
}