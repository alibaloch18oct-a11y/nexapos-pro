/* POS product cards professional treatment */

[style*="min-height: 224px"],
[style*="min-height: 285px"] {
  background:
    radial-gradient(circle at 50% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 0%, rgba(168, 85, 247, 0.13), transparent 35%),
    linear-gradient(135deg, rgba(15, 23, 42, 0.94), rgba(2, 6, 23, 0.72)) !important;
  border-color: rgba(255, 255, 255, 0.095) !important;
  box-shadow:
    0 16px 44px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.055) !important;
}

/* Tables and visual areas */

[style*="background: radial-gradient(circle at center"] {
  background:
    radial-gradient(circle at center, rgba(34, 211, 238, 0.08), rgba(15, 23, 42, 0.94)),
    linear-gradient(135deg, #111827, #020617) !important;
}

/* Make all large fixed page paddings feel compact */

div[style*="min-height: 100vh"][style*="padding: 18px"],
div[style*="min-height: 100vh"][style*="padding: 22px"] {
  padding: 13px !important;
}

/* Professional hover system */

.nexa-panel,
.nexa-stat-card,
.nexa-module-card,
.nexa-select-card,
.nexa-input-wrap,
.nexa-modal {
  transition:
    transform 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.nexa-panel:hover {
  border-color: rgba(34, 211, 238, 0.18);
}

/* Tables */

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  padding: 10px 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 12px;
}

th {
  color: #cbd5e1;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

/* Print support */

@media print {
  body {
    background: white !important;
  }
}

/* Responsive */

@media (max-width: 1180px) {
  .nexa-container,
  .nexa-topbar {
    width: min(100vw - 20px, 1520px);
  }

  .nexa-modules-grid,
  .nexa-module-select-grid {
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }

  .nexa-stat-card {
    min-height: 104px;
  }
}

@media (max-width: 760px) {
  :root {
    font-size: 12px;
  }

  .nexa-container {
    padding-top: 12px;
  }

  .nexa-topbar,
  .nexa-row-between {
    align-items: stretch;
    flex-direction: column;
  }

  .nexa-form-grid {
    grid-template-columns: 1fr;
  }

  .nexa-client-title,
  .nexa-login-heading {
    font-size: 34px;
  }

  .nexa-modules-grid,
  .nexa-module-select-grid,
  .nexa-stats {
    grid-template-columns: 1fr;
  }
}
/* =========================================================
   CHROME BROWSER HEIGHT FIX - NEXAPOS DASHBOARD
   Desktop installed app stays compact, browser can scroll.
   ========================================================= */

html,
body,
#root {
  min-height: 100%;
}

body {
  overflow-x: hidden;
}

/* Browser mode: Chrome has less vertical height because of tabs/address bar */
@media (display-mode: browser) {
  .client-dashboard,
  .client-dashboard-shell,
  .dashboard-page,
  .main-dashboard,
  .modules-dashboard,
  .nexa-dashboard,
  .app-dashboard {
    min-height: 100dvh !important;
    height: auto !important;
    max-height: none !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
  }

  .client-dashboard *,
  .dashboard-page *,
  .main-dashboard *,
  .modules-dashboard * {
    scrollbar-width: thin;
  }

  .dashboard-main,
  .dashboard-content,
  .dashboard-modules,
  .modules-grid,
  .module-grid,
  .dashboard-module-grid,
  .main-module-grid {
    height: auto !important;
    max-height: none !important;
    overflow: visible !important;
  }
}

/* Installed desktop/PWA mode: keep app-style full screen layout */
@media (display-mode: standalone) {
  .client-dashboard,
  .client-dashboard-shell,
  .dashboard-page,
  .main-dashboard,
  .modules-dashboard,
  .nexa-dashboard,
  .app-dashboard {
    min-height: 100dvh !important;
  }
}

/* Smaller browser heights: make module cards slightly tighter */
@media (max-height: 820px) and (display-mode: browser) {
  .module-card,
  .dashboard-module-card,
  .client-module-card,
  .mode-card,
  .pos-mode-card {
    min-height: 118px !important;
    padding-top: 14px !important;
    padding-bottom: 14px !important;
  }

  .dashboard-header,
  .client-dashboard-header,
  .main-dashboard-header {
    margin-bottom: 10px !important;
  }

  .dashboard-footer,
  .client-dashboard-footer,
  .main-dashboard-footer {
    margin-top: 10px !important;
  }
}

/* Very small laptop browser height */
@media (max-height: 720px) and (display-mode: browser) {
  .module-card,
  .dashboard-module-card,
  .client-module-card,
  .mode-card,
  .pos-mode-card {
    min-height: 104px !important;
  }
}

