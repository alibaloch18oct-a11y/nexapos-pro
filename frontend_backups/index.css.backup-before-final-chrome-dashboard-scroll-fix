@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap");

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f8fafc;
  background: #020617;

  --nexa-bg: #020617;
  --nexa-panel: rgba(15, 23, 42, 0.72);
  --nexa-panel-strong: rgba(15, 23, 42, 0.9);
  --nexa-border: rgba(255, 255, 255, 0.105);
  --nexa-border-strong: rgba(34, 211, 238, 0.34);
  --nexa-text: #f8fafc;
  --nexa-muted: #94a3b8;
  --nexa-soft: rgba(255, 255, 255, 0.06);
  --nexa-soft-2: rgba(255, 255, 255, 0.09);
  --nexa-cyan: #22d3ee;
  --nexa-blue: #38bdf8;
  --nexa-purple: #a855f7;
  --nexa-green: #22c55e;
  --nexa-red: #ef4444;
  --nexa-yellow: #facc15;

  font-size: 13px;
  font-synthesis: none;
  text-rendering: geometricPrecision;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: #020617;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  color: var(--nexa-text);
  background:
    radial-gradient(circle at top left, rgba(34, 211, 238, 0.16), transparent 32%),
    radial-gradient(circle at top right, rgba(168, 85, 247, 0.18), transparent 30%),
    radial-gradient(circle at bottom, rgba(59, 130, 246, 0.12), transparent 38%),
    linear-gradient(135deg, #020617 0%, #08111f 42%, #020617 100%);
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -3;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.027) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.027) 1px, transparent 1px);
  background-size: 34px 34px;
  mask-image: radial-gradient(circle at center, black 0%, transparent 78%);
}

body::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -2;
  background:
    linear-gradient(115deg, transparent 0%, rgba(34, 211, 238, 0.055) 42%, transparent 58%),
    linear-gradient(245deg, transparent 0%, rgba(168, 85, 247, 0.06) 42%, transparent 61%);
  animation: nexa-scan 10s linear infinite;
}

@keyframes nexa-scan {
  0% {
    opacity: 0.35;
    transform: translateX(-3%);
  }
  50% {
    opacity: 0.85;
    transform: translateX(3%);
  }
  100% {
    opacity: 0.35;
    transform: translateX(-3%);
  }
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  user-select: none;
}

button:disabled {
  opacity: 0.55;
  cursor: not-allowed !important;
}

a {
  color: inherit;
}

::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: rgba(15, 23, 42, 0.55);
  border-radius: 999px;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, rgba(34, 211, 238, 0.7), rgba(168, 85, 247, 0.65));
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, rgba(34, 211, 238, 0.95), rgba(168, 85, 247, 0.9));
}

#root {
  min-height: 100vh;
}

/* Main page shell */

.nexa-page {
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.nexa-container {
  width: min(1520px, calc(100vw - 30px));
  margin: 0 auto;
  padding: 18px 0 28px;
}

/* Global compacting for the whole app */

.nexa-page,
.nexa-container,
.nexa-panel,
.nexa-modal,
.nexa-login-card,
.nexa-module-card,
.nexa-stat-card {
  letter-spacing: -0.015em;
}

.nexa-page svg,
.nexa-modal svg,
.nexa-panel svg,
.nexa-module-card svg,
.nexa-stat-card svg {
  width: 0.92em;
  height: 0.92em;
}

/* Top bar */

.nexa-topbar {
  width: min(1520px, calc(100vw - 30px));
  margin: 14px auto 0;
  min-height: 66px;
  padding: 10px 14px;
  border: 1px solid var(--nexa-border);
  border-radius: 24px;
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.88), rgba(2, 6, 23, 0.7)),
    radial-gradient(circle at top left, rgba(34, 211, 238, 0.14), transparent 34%);
  backdrop-filter: blur(22px);
  box-shadow: 0 22px 70px rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.nexa-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nexa-brand-icon,
.nexa-logo-box {
  width: 46px;
  height: 46px;
  border-radius: 17px;
  display: grid;
  place-items: center;
  color: white;
  background:
    radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.35), transparent 24%),
    linear-gradient(135deg, #06b6d4, #7c3aed);
  box-shadow:
    0 0 30px rgba(34, 211, 238, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.28);
}

.nexa-brand-title {
  margin: 0;
  font-size: 18px;
  font-weight: 950;
  line-height: 1.1;
}

.nexa-brand-subtitle {
  margin: 3px 0 0;
  color: var(--nexa-muted);
  font-size: 12px;
  font-weight: 700;
}

.nexa-user-chip {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 8px 10px;
  border: 1px solid var(--nexa-border);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.065);
  color: #e2e8f0;
  font-size: 12px;
  font-weight: 800;
}

/* Hero */

.nexa-hero-panel {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--nexa-border);
  border-radius: 30px;
  padding: 24px;
  margin-bottom: 18px;
  background:
    radial-gradient(circle at 20% 20%, rgba(34, 211, 238, 0.19), transparent 36%),
    radial-gradient(circle at 82% 30%, rgba(168, 85, 247, 0.18), transparent 34%),
    linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(2, 6, 23, 0.72));
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
  backdrop-filter: blur(22px);
}

.nexa-hero-panel::before {
  content: "";
  position: absolute;
  inset: -1px;
  pointer-events: none;
  background:
    linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.16), transparent),
    linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 32%);
  opacity: 0.8;
}

.nexa-badge,
.nexa-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 33px;
  padding: 7px 11px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.115);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.085), rgba(255, 255, 255, 0.045));
  color: #dbeafe;
  font-size: 11.5px;
  font-weight: 850;
  line-height: 1;
  backdrop-filter: blur(14px);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.nexa-badge {
  color: #a5f3fc;
  border-color: rgba(34, 211, 238, 0.26);
  background: rgba(34, 211, 238, 0.095);
}

.nexa-client-title,
.nexa-login-heading {
  margin: 12px 0 6px;
  font-size: clamp(28px, 4vw, 52px);
  line-height: 0.96;
  font-weight: 950;
  letter-spacing: -0.065em;
  background: linear-gradient(90deg, #fff, #a5f3fc, #d8b4fe);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nexa-hero-p,
.nexa-login-sub,
.nexa-section-sub,
.nexa-small {
  color: var(--nexa-muted);
  font-weight: 650;
  line-height: 1.55;
}

.nexa-hero-p {
  max-width: 760px;
  margin: 0;
  font-size: 13.5px;
}

.nexa-section-title {
  margin: 0;
  font-size: 24px;
  line-height: 1.05;
  font-weight: 950;
  letter-spacing: -0.055em;
}

.nexa-section-sub {
  margin: 5px 0 0;
  font-size: 12.5px;
}

.nexa-small {
  margin: 4px 0;
  font-size: 11.5px;
}

/* Stats */

.nexa-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(178px, 1fr));
  gap: 12px;
  margin: 14px 0 18px;
}

.nexa-stat-card {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--nexa-border);
  border-radius: 24px;
  padding: 15px;
  min-height: 116px;
  background:
    radial-gradient(circle at top right, rgba(168, 85, 247, 0.13), transparent 38%),
    linear-gradient(135deg, rgba(15, 23, 42, 0.84), rgba(2, 6, 23, 0.62));
  box-shadow: 0 16px 46px rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(18px);
}

.nexa-stat-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(125deg, transparent, rgba(255, 255, 255, 0.055), transparent);
  opacity: 0;
  transition: opacity 0.25s ease;
}

.nexa-stat-card:hover::after {
  opacity: 1;
}

.nexa-stat-card svg {
  font-size: 28px;
  color: #d8b4fe;
  filter: drop-shadow(0 0 16px rgba(168, 85, 247, 0.32));
}

.nexa-stat-label {
  margin: 12px 0 2px;
  color: var(--nexa-muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 850;
}

.nexa-stat-value {
  margin: 0;
  color: white;
  font-size: 22px;
  line-height: 1;
  font-weight: 950;
  letter-spacing: -0.045em;
}

/* Modules */

.nexa-modules-grid,
.nexa-module-select-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  gap: 13px;
}

.nexa-module-card,
.nexa-select-card {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--nexa-border);
  border-radius: 24px;
  padding: 16px;
  min-height: 188px;
  text-align: left;
  color: white;
  background:
    radial-gradient(circle at 22% 12%, rgba(34, 211, 238, 0.12), transparent 30%),
    radial-gradient(circle at 88% 15%, rgba(168, 85, 247, 0.14), transparent 34%),
    linear-gradient(135deg, rgba(15, 23, 42, 0.82), rgba(2, 6, 23, 0.64));
  cursor: pointer;
  box-shadow: 0 18px 52px rgba(0, 0, 0, 0.26);
  backdrop-filter: blur(18px);
  transition:
    transform 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.nexa-module-card::before,
.nexa-select-card::before,
.nexa-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.09), transparent 28%),
    linear-gradient(315deg, rgba(34, 211, 238, 0.075), transparent 38%);
  opacity: 0.7;
}

.nexa-module-card:hover,
.nexa-select-card:hover {
  transform: translateY(-4px);
  border-color: rgba(34, 211, 238, 0.32);
  box-shadow:
    0 20px 65px rgba(0, 0, 0, 0.35),
    0 0 35px rgba(34, 211, 238, 0.12);
}

.nexa-select-card.active {
  border-color: rgba(34, 211, 238, 0.55);
  background:
    radial-gradient(circle at top left, rgba(34, 211, 238, 0.22), transparent 42%),
    rgba(15, 23, 42, 0.86);
  box-shadow:
    0 0 0 1px rgba(34, 211, 238, 0.08),
    0 18px 58px rgba(34, 211, 238, 0.13);
}

.nexa-module-icon {
  width: 52px;
  height: 52px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  color: #a5f3fc;
  background:
    radial-gradient(circle at top, rgba(34, 211, 238, 0.35), transparent 50%),
    rgba(34, 211, 238, 0.11);
  border: 1px solid rgba(34, 211, 238, 0.18);
  box-shadow: 0 12px 26px rgba(34, 211, 238, 0.08);
}

.nexa-module-title {
  margin: 14px 0 6px;
  font-size: 17px;
  line-height: 1.08;
  font-weight: 950;
  letter-spacing: -0.04em;
}

.nexa-module-desc {
  margin: 0;
  color: var(--nexa-muted);
  font-size: 12px;
  line-height: 1.45;
  font-weight: 650;
}

.nexa-module-open {
  margin-top: 14px;
  color: #a5f3fc;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 900;
}

/* Panels and cards */

.nexa-panel {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--nexa-border);
  border-radius: 26px;
  padding: 16px;
  background:
    radial-gradient(circle at top left, rgba(34, 211, 238, 0.09), transparent 38%),
    linear-gradient(135deg, rgba(15, 23, 42, 0.84), rgba(2, 6, 23, 0.66));
  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(20px);
}

.nexa-row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
}

/* Forms */

.nexa-field {
  display: grid;
  gap: 6px;
  margin-top: 11px;
}

.nexa-label {
  color: #cbd5e1;
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: 0.065em;
}

.nexa-input-wrap {
  min-height: 42px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 12px;
  border-radius: 15px;
  border: 1px solid var(--nexa-border);
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.78), rgba(30, 41, 59, 0.48));
  color: #f8fafc;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.055),
    0 10px 28px rgba(0, 0, 0, 0.14);
  transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.nexa-input-wrap:focus-within {
  border-color: rgba(34, 211, 238, 0.42);
  box-shadow:
    0 0 0 4px rgba(34, 211, 238, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.nexa-input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: white;
  font-size: 12.5px;
  font-weight: 700;
}

.nexa-input::placeholder {
  color: #64748b;
}

select.nexa-input option {
  background: #0f172a;
  color: #f8fafc;
}

.nexa-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

/* Buttons */

.nexa-btn,
.nexa-create-btn,
.nexa-logout {
  min-height: 40px;
  border: 0;
  border-radius: 15px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 9px 13px;
  font-size: 12px;
  font-weight: 950;
  color: white;
  cursor: pointer;
  transition:
    transform 0.16s ease,
    box-shadow 0.16s ease,
    filter 0.16s ease,
    border-color 0.16s ease;
}

.nexa-btn,
.nexa-create-btn {
  background:
    radial-gradient(circle at top left, rgba(255, 255, 255, 0.22), transparent 28%),
    linear-gradient(135deg, #06b6d4, #2563eb 48%, #7c3aed);
  box-shadow:
    0 14px 34px rgba(37, 99, 235, 0.24),
    0 0 28px rgba(34, 211, 238, 0.14);
}

.nexa-btn:hover,
.nexa-create-btn:hover {
  transform: translateY(-2px);
  filter: brightness(1.08);
  box-shadow:
    0 18px 44px rgba(37, 99, 235, 0.32),
    0 0 34px rgba(34, 211, 238, 0.2);
}

.nexa-logout {
  border: 1px solid var(--nexa-border);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.095), rgba(255, 255, 255, 0.045));
  color: #e2e8f0;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.055);
}

.nexa-logout:hover {
  transform: translateY(-2px);
  border-color: rgba(248, 113, 113, 0.36);
  background: rgba(239, 68, 68, 0.12);
}

/* Login */

.nexa-center {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 22px;
}

.nexa-login-card {
  width: min(460px, 100%);
  border: 1px solid var(--nexa-border);
  border-radius: 32px;
  padding: 28px;
  background:
    radial-gradient(circle at top left, rgba(34, 211, 238, 0.14), transparent 34%),
    radial-gradient(circle at top right, rgba(168, 85, 247, 0.15), transparent 38%),
    rgba(15, 23, 42, 0.82);
  box-shadow:
    0 24px 80px rgba(0, 0, 0, 0.36),
    0 0 45px rgba(34, 211, 238, 0.08);
  backdrop-filter: blur(24px);
}

/* Modal */

.nexa-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  padding: 18px;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at center, rgba(34, 211, 238, 0.12), transparent 50%),
    rgba(2, 6, 23, 0.82);
  backdrop-filter: blur(16px);
}

.nexa-modal {
  width: min(94vw, 980px);
  max-height: 92vh;
  overflow-y: auto;
  border: 1px solid var(--nexa-border);
  border-radius: 28px;
  padding: 20px;
  background:
    radial-gradient(circle at top left, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at top right, rgba(168, 85, 247, 0.12), transparent 36%),
    rgba(15, 23, 42, 0.92);
  box-shadow:
    0 34px 110px rgba(0, 0, 0, 0.52),
    0 0 42px rgba(34, 211, 238, 0.1);
  backdrop-filter: blur(24px);
}

