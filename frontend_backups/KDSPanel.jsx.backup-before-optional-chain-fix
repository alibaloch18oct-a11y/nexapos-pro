              radial-gradient(circle at 86% 12%, rgba(168,85,247,.13), transparent 30%),
              linear-gradient(180deg,#020617,#071028);
          }

          .kds-head {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            align-items: start;
            margin-bottom: 16px;
          }

          .kds-back,
          .kds-soft-btn,
          .kds-primary-btn,
          .kds-icon-btn {
            border: 0;
            color: white;
            font-weight: 900;
            cursor: pointer;
            transition: .18s ease;
          }

          .kds-back,
          .kds-soft-btn,
          .kds-icon-btn {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.10);
          }

          .kds-back,
          .kds-soft-btn,
          .kds-primary-btn {
            height: 44px;
            padding: 0 14px;
            border-radius: 15px;
          }

          .kds-icon-btn {
            width: 46px;
            height: 46px;
            border-radius: 16px;
          }

          .kds-primary-btn {
            background: linear-gradient(135deg,#06b6d4,#2563eb);
          }

          .kds-title {
            margin: 13px 0 4px;
            font-size: 34px;
            font-weight: 1000;
            letter-spacing: -.04em;
          }

          .kds-sub {
            margin: 0;
            color: #94a3b8;
          }

          .kds-head-actions {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
            justify-content: flex-end;
          }

          .kds-stats {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            margin-bottom: 14px;
          }

          .kds-stat-card {
            padding: 14px;
            border-radius: 22px;
            background: rgba(15,23,42,.75);
            border: 1px solid rgba(255,255,255,.10);
          }

          .kds-stat-card span {
            color: #94a3b8;
