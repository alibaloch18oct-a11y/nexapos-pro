            50% { transform: scale(1.01); }
          }

          .kds-card-head {
            display: flex;
            justify-content: space-between;
            gap: 12px;
          }

          .kds-card h3 {
            margin: 0;
            font-size: 23px;
          }

          .kds-card p {
            margin: 5px 0 0;
            color: #94a3b8;
            font-size: 13px;
          }

          .kds-customer-token {
            margin-top: 5px;
            color: #a5f3fc;
            font-size: 13px;
            font-weight: 900;
          }

          .kds-status-icon {
            width: 58px;
            height: 58px;
            border-radius: 21px;
            border: 1px solid;
            display: grid;
            place-items: center;
            font-size: 29px;
          }

          .kds-timer-box {
            margin-top: 12px;
            padding: 12px;
            border-radius: 20px;
            background: rgba(2,6,23,.38);
            border: 1px solid rgba(255,255,255,.08);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
          }

          .kds-timer-box span {
            display: block;
            color: #94a3b8;
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 4px;
          }

          .kds-timer-box strong {
            font-size: 20px;
            font-weight: 1000;
          }

          .timer-overdue {
            color: #fca5a5 !important;
          }

          .kds-progress {
            height: 9px;
            border-radius: 999px;
            background: rgba(255,255,255,.08);
            overflow: hidden;
            margin-top: 9px;
          }

          .kds-progress div {
            height: 100%;
            border-radius: inherit;
            transition: width .4s ease;
          }

          .kds-pill-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 12px;
          }

          .kds-pill-row span {
            padding: 8px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,.07);
            border: 1px solid rgba(255,255,255,.08);
            font-size: 12px;
            font-weight: 850;
          }

          .kds-workflow {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(92px, 1fr));
            gap: 8px;
            margin-top: 12px;
          }

          .kds-step {
            min-height: 60px;
            border-radius: 17px;
            border: 1px solid;
            cursor: pointer;
            display: grid;
            justify-items: center;
            align-content: center;
            gap: 4px;
            font-weight: 850;
          }

          .kds-step b {
            font-size: 20px;
          }

          .kds-step span {
            font-size: 11px;
          }

          .kds-items-box {
            margin-top: 12px;
            border-radius: 20px;
            background: rgba(2,6,23,.38);
            border: 1px solid rgba(255,255,255,.08);
            overflow: hidden;
          }

          .kds-item-row {
            display: grid;
            grid-template-columns: 42px 1fr auto;
            gap: 10px;
            align-items: center;
            padding: 11px;
            border-bottom: 1px solid rgba(255,255,255,.07);
          }

          .kds-item-row:last-child {
            border-bottom: 0;
          }

          .kds-qty {
            width: 36px;
            height: 36px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            background: rgba(34,211,238,.13);
            color: #a5f3fc;
            font-weight: 1000;
          }

          .kds-note-box {
            margin-top: 12px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(250,204,21,.08);
            border: 1px solid rgba(250,204,21,.18);
          }

          .kds-note-box p {
            margin: 0 0 5px;
          }

          .kds-note-box strong {
            color: #fde68a;
          }

          .kds-card-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 12px;
          }

          .kds-card-actions button {
            min-height: 38px;
            border-radius: 13px;
            border: 1px solid rgba(255,255,255,.10);
            background: rgba(255,255,255,.07);
            color: white;
            padding: 0 10px;
            font-weight: 850;
            cursor: pointer;
          }

          .kds-card-actions button.primary {
            background: linear-gradient(135deg,#06b6d4,#2563eb);
            border: 0;
          }

          .kds-muted {
            padding: 14px;
            color: #94a3b8;
          }

          .kds-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: rgba(2,6,23,.72);
            backdrop-filter: blur(10px);
            display: grid;
            place-items: center;
            padding: 18px;
          }

          .kds-settings-modal {
            width: min(760px, calc(100vw - 36px));
            max-height: calc(100vh - 36px);
            overflow-y: auto;
            border-radius: 28px;
            background: #0f172a;
            border: 1px solid rgba(255,255,255,.12);
            box-shadow: 0 30px 90px rgba(0,0,0,.45);
            padding: 18px;
          }

          .kds-modal-head {
            display: flex;
            justify-content: space-between;
            align-items: start;
            gap: 14px;
            margin-bottom: 14px;
          }

          .kds-modal-head h2 {
            margin: 0;
          }

          .kds-modal-head p {
            margin: 6px 0 0;
            color: #94a3b8;
          }

          .kds-toggle-row {
            padding: 14px;
            border-radius: 20px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.10);
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            margin-bottom: 14px;
          }

          .kds-toggle-row small {
            display: block;
            margin-top: 4px;
            color: #94a3b8;
          }

          .kds-toggle-row input {
            width: 22px;
            height: 22px;
          }

          .kds-settings-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
          }

          .kds-field {
            padding: 13px;
            border-radius: 20px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.10);
            display: grid;
            gap: 8px;
          }

          .kds-field span {
            font-weight: 900;
          }

          .kds-field input {
            height: 42px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.10);
            background: rgba(255,255,255,.08);
            color: white;
            padding: 0 12px;
            outline: none;
          }

          .kds-field small {
            color: #94a3b8;
          }

          .kds-modal-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 14px;
          }

          @media (max-width: 960px) {
            .kds-stats,
            .kds-toolbar,
            .kds-settings-grid,
            .kds-modal-actions,
            .kds-timer-box {
              grid-template-columns: 1fr;
            }

            .kds-filter-row {
              justify-content: flex-start;
            }
          }
        `}
      </style>

      <div className="kds-head">
        <div>
          <button className="kds-back" onClick={onBack}>← Back</button>
          <h1 className="kds-title">Kitchen Display System</h1>
          <p className="kds-sub">
            Accurate live timers with auto workflow: New → Preparing → Ready. Delivery adds rider and cash received steps.
          </p>
        </div>

        <div className="kds-head-actions">
          <button className="kds-soft-btn" onClick={() => setSoundEnabled((prev) => !prev)}>
            Sound {soundEnabled × "On" : "Off"}
          </button>

          <button className="kds-soft-btn" onClick={() => setAutoRefreshEnabled((prev) => !prev)}>
            Refresh {autoRefreshEnabled × "Auto 5s" : "Manual"}
          </button>

          <button className="kds-soft-btn" onClick={() => setSettingsOpen(true)}>
            Timer Settings
          </button>

          <button className="kds-primary-btn" onClick={() => loadBoard()}>
            Refresh Board
          </button>
        </div>
      </div>

      <div className="kds-stats">
        <div className="kds-stat-card"><span>New</span><strong>{stats.new}</strong></div>
        <div className="kds-stat-card"><span>Preparing</span><strong>{stats.preparing}</strong></div>
        <div className="kds-stat-card"><span>Ready</span><strong>{stats.ready}</strong></div>
        <div className="kds-stat-card"><span>Delivery</span><strong>{stats.delivery}</strong></div>
        <div className="kds-stat-card"><span>Rider Flow</span><strong>{stats.rider}</strong></div>
        <div className="kds-stat-card"><span>Cash Done</span><strong>{stats.cash}</strong></div>
      </div>

      <div className="kds-toolbar">
        <input
          className="kds-search"
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          placeholder="Search order, item, phone, rider..."
        />

        <div className="kds-filter-row">
          {["active", "all", "new", "preparing", "ready", "rider_picked", "rider_on_way", "rider_delivered", "cash_received"].map((item) => (
            <button
              key={item}
              className={statusFilter === item × "active" : ""}
              onClick={() => setStatusFilter(item)}
            >
              {item === "active" × "Active" : statusLabel(item)}
            </button>
          ))}

          {["all", "dine_in", "take_away", "delivery", "drive_thru"].map((item) => (
            <button
              key={item}
              className={modeFilter === item × "active" : ""}
              onClick={() => setModeFilter(item)}
            >
              {item === "all" × "All Modes" : normalizeMode(item)}
            </button>
          ))}
        </div>
      </div>

      {loading × (
        <div className="kds-muted">Loading KDS board...</div>
      ) : filteredOrders.length === 0 × (
        <div className="kds-muted">No KDS orders found.</div>
      ) : (
        <div className="kds-grid">
          {filteredOrders.map((order) => (
            <KDSOrderCard
              key={orderKey(order)}
              order={order}
              settings={settings}
              nowMs={nowMs}
              isFresh={freshOrderIds.includes(orderKey(order))}
              onUpdateStatus={updateOrderStatus}
            />
          ))}
        </div>
      )}

      <p className="kds-muted">
        Last refresh: {lastRefreshAt || "Not refreshed"} · Auto timer: {settings.autoEnabled × "Enabled" : "Disabled"}
      </p>

      {settingsOpen × (
        <SettingsModal
          settings={settings}
          setSettings={setSettings}
          onClose={() => setSettingsOpen(false)}
          onSave={saveSettings}
          saving={savingSettings}
        />
      ) : null}
    </div>
  );
}

