function money(settings, value) {
  return `${settings.currency || "Rs"} ${Math.round(Number(value || 0)).toLocaleString()}`;
}

function escapeXml(value) {
  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

