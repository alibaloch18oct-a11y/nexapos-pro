import React, { useEffect, useMemo, useState } from "react";
import { api } from "../lib/api";
import ThermalReceipt from "./ThermalReceipt";

const defaultSettings = {
  restaurantName: "Nexa Restaurant",
  receiptTitle: "Nexa Restaurant",
  receiptSubtitle: "Premium Restaurant POS Receipt",
  currency: "Rs",
  taxName: "GST",
  serviceChargeName: "Service Charges",
  receiptFooter: "Thank you for your order.",
  receiptNote: "Powered by NexaPOS Pro"
};

const payNowMethods = ["Cash", "Card", "Easypaisa", "JazzCash", "Bank Transfer"];

function money(order, value) {
  return `${order?.currency || order?.restaurantSettings?.currency || "Rs"} ${Math.round(Number(value || 0)).toLocaleString()}`;
}

function normalizeMode(mode) {
  const map = {
    dine_in: "Dine In",
    take_away: "Take Away",
    delivery: "Delivery",
    drive_thru: "Drive Thru",
    walk_in: "Walk In",
    kiosk: "Kiosk"
  };

  return map[mode] || mode || "POS";
}

function formatDate(value) {
  if (!value) return "N/A";
  try {
    return new Date(value).toLocaleString();
  } catch {
    return "N/A";
  }
}

function statusColor(status) {
  if (status === "paid") return "#86efac";
  if (status === "unpaid") return "#fde68a";
  if (status === "complimentary") return "#a5f3fc";
  if (status === "cancelled") return "#fca5a5";
  return "#cbd5e1";
}


function paymentBadge(order) {
  const status = String(order?.paymentStatus || "").toLowerCase();
  const method = String(order?.paymentMethod || "").toLowerCase();
  const rawMethod = order?.paymentMethod || "";

  if (status === "cancelled") {
    return { label: "CANCELLED", sub: "Order cancelled", cls: "cancelled" };
  }

  if (status === "complimentary" || method.includes("complimentary")) {
    return { label: "COMPLIMENTARY", sub: "VIP / free order", cls: "comp" };
  }

  if (status === "unpaid" || method.includes("unpaid") || method.includes("pay later")) {
    return { label: "UNPAID", sub: rawMethod || "Pay later", cls: "unpaid" };
  }

  if (method.includes("cash on delivery") || method === "cod") {
    return { label: "COD / UNPAID", sub: "Cash on delivery", cls: "unpaid" };
  }

  if (status === "paid") {
    if (method.includes("card")) return { label: "PAID / CARD", sub: rawMethod || "Card", cls: "paid" };
    if (method.includes("cash")) return { label: "PAID / CASH", sub: rawMethod || "Cash", cls: "paid" };
    if (method.includes("easy")) return { label: "PAID / EASYPAISA", sub: rawMethod, cls: "paid" };
    if (method.includes("jazz")) return { label: "PAID / JAZZCASH", sub: rawMethod, cls: "paid" };
    if (method.includes("bank")) return { label: "PAID / BANK", sub: rawMethod, cls: "paid" };
    return { label: rawMethod ? `PAID / ${rawMethod.toUpperCase()}` : "PAID", sub: rawMethod || "Paid order", cls: "paid" };
  }

  return { label: status ? status.toUpperCase() : "UNKNOWN", sub: rawMethod || "No payment method", cls: "neutral" };
}

function orderNeedsPayment(order) {
  const status = String(order?.paymentStatus || "").toLowerCase();
  const method = String(order?.paymentMethod || "").toLowerCase();

  if (status === "cancelled" || status === "paid" || status === "complimentary") return false;

  return (
    status === "unpaid" ||
    method.includes("unpaid") ||
    method.includes("pay later") ||
    method.includes("cash on delivery") ||
    method === "cod"
  );
}

function safeItems(items) {
  return Array.isArray(items) ? items : [];
}

function EditOrderModal({ token, order, menuItems, onClose, onSaved }) {
  const [items, setItems] = useState(safeItems(order.items).map((item) => ({
    ...item,
    qty: Number(item.qty || item.quantity || 1),
    quantity: Number(item.qty || item.quantity || 1),
    price: Number(item.price || 0)
  })));
  const [search, setSearch] = useState("");
  const [saving, setSaving] = useState(false);

  const settings = order.restaurantSettings || {};
  const taxPercent = Number(order.taxPercent || settings.taxPercent || 0);
  const serviceChargePercent = Number(order.serviceChargePercent || settings.serviceChargePercent || 0);
  const systemDiscountAmount = Number(order.systemDiscountAmount || 0);
  const loyaltyRedeemedAmount = Number(order.loyaltyRedeemedAmount || 0);

  const subtotal = items.reduce((sum, item) => sum + Number(item.price || 0) * Number(item.qty || 1), 0);
  const safeDiscount = Math.min(subtotal, Math.max(0, systemDiscountAmount));
  const discountedSubtotal = Math.max(0, subtotal - safeDiscount);
  const tax = Math.round(discountedSubtotal * (taxPercent / 100));
  const serviceChargeAmount = Math.round(discountedSubtotal * (serviceChargePercent / 100));
  const total = Math.max(0, discountedSubtotal + tax + serviceChargeAmount - loyaltyRedeemedAmount);

  const filteredMenu = menuItems.filter((item) => {
    const q = search.toLowerCase();
    return (
      !q ||
      String(item.name || "").toLowerCase().includes(q) ||
      String(item.category || "").toLowerCase().includes(q)
    );
  });

  function addItem(item) {
    setItems((prev) => {
      const found = prev.find((x) => x.id === item.id);

      if (found) {
        return prev.map((x) =>
          x.id === item.id
            ? {
                ...x,
                qty: Number(x.qty || 1) + 1,
                quantity: Number(x.qty || 1) + 1
              }
            : x
        );
      }

      return [
        ...prev,
        {
          ...item,
          qty: 1,
          quantity: 1,
          price: Number(item.price || 0),
          category: item.category || "Menu"
        }
      ];
    });
  }

  function changeQty(id, delta) {
    setItems((prev) =>
      prev.map((item) =>
        item.id === id
          ? {
              ...item,
              qty: Math.max(1, Number(item.qty || 1) + delta),
              quantity: Math.max(1, Number(item.qty || 1) + delta)
            }
          : item
      )
    );
  }

  function removeItem(id) {
    setItems((prev) => prev.filter((item) => item.id !== id));
  }

  async function saveEdit() {
    if (!items.length) {
      alert("Order must contain at least one item. Use Cancel Order if you want to cancel it.");
      return;
    }

    setSaving(true);

    try {
      const res = await api(token).patch(`/api/order-edit/${order.id || order.orderNo}`, {
        items,
        orderStatus: order.orderStatus === "served" || order.orderStatus === "completed" ? order.orderStatus : "placed",
        kitchenStatus: "placed"
      });

      alert("Order updated successfully. KDS will show updated items after refresh.");
      onSaved(res.data.order);
      onClose();
    } catch (error) {
      alert(error.response?.data?.message || "Failed to update order.");
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="orders-modal-backdrop">
      <div className="orders-edit-modal">
        <div className="orders-modal-head">
          <div>
            <h2>Edit Order {order.orderNo}</h2>
            <p>Update items, quantities, and send changes back to kitchen.</p>
          </div>

          <button className="orders-icon-btn" onClick={onClose}>×</button>
        </div>

        <div className="orders-edit-grid">
          <section className="orders-edit-left">
            <div className="orders-section-title">Current Order Items</div>

            {items.length === 0 ? (
              <div className="orders-empty">No items in order.</div>
            ) : (
              <div className="orders-edit-items">
                {items.map((item) => (
                  <div className="orders-edit-item" key={item.id}>
                    <div>
                      <strong>{item.name}</strong>
                      <p>{item.category || item.subtitle || "Menu Item"}</p>
                      <span>{money(order, item.price)} x {item.qty}</span>
                    </div>

                    <div className="orders-edit-actions">
                      <button onClick={() => changeQty(item.id, -1)}>-</button>
                      <strong>{item.qty}</strong>
                      <button onClick={() => changeQty(item.id, 1)}>+</button>
                      <button className="danger" onClick={() => removeItem(item.id)}>Delete</button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>

          <section className="orders-edit-right">
            <div className="orders-section-title">Add More Items</div>

            <input
              className="orders-search"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search menu item..."
            />

            <div className="orders-menu-add-list">
              {filteredMenu.slice(0, 80).map((item) => (
                <button className="orders-menu-add-card" key={item.id} onClick={() => addItem(item)}>
                  <div>
                    <strong>{item.name}</strong>
                    <p>{item.category || "Menu"}</p>
                  </div>
                  <span>{money(order, item.price)}</span>
                </button>
              ))}
            </div>
          </section>

          <aside className="orders-edit-summary">
            <h3>Updated Bill</h3>

            <div className="orders-summary-row">
              <span>Subtotal</span>
              <strong>{money(order, subtotal)}</strong>
            </div>

            <div className="orders-summary-row">
              <span>Discount</span>
              <strong>- {money(order, safeDiscount)}</strong>
            </div>

            <div className="orders-summary-row">
              <span>{order.taxName || "Tax"} ({taxPercent}%)</span>
              <strong>{money(order, tax)}</strong>
            </div>

            <div className="orders-summary-row">
              <span>{order.serviceChargeName || "Service"} ({serviceChargePercent}%)</span>
              <strong>{money(order, serviceChargeAmount)}</strong>
            </div>

            <div className="orders-summary-row">
              <span>Loyalty</span>
              <strong>- {money(order, loyaltyRedeemedAmount)}</strong>
            </div>

            <div className="orders-line" />

            <div className="orders-summary-row total">
              <span>Grand Total</span>
              <strong>{money(order, total)}</strong>
            </div>

            <button className="orders-primary-btn" onClick={saveEdit} disabled={saving}>
              {saving ? "Saving..." : "Save Edited Order"}
            </button>

            <button className="orders-soft-btn" onClick={onClose}>
              Close
            </button>
          </aside>
        </div>
      </div>
    </div>
  );
}


