const express = require("express");

const router = express.Router();

const defaultKdsSettings = {
  autoEnabled: true,
  newToPreparingMinutes: 2,
  preparingToReadyMinutes: 8,
  readyToRiderPickedMinutes: 2,
  riderPickedToOnWayMinutes: 2,
  riderOnWayToDeliveredMinutes: 20,
  deliveredToCashReceivedMinutes: 3
};

const allowedStatuses = [
  "new",
  "placed",
  "preparing",
  "ready",
  "served",
  "completed",
  "cancelled",
  "rider_picked",
  "rider_on_way",
  "rider_delivered",
  "cash_received"
];

function tenantOnly(req, res, next) {
  if (!req.user?.tenantId) {
    return res.status(403).json({
      message: "Restaurant account access required."
    });
  }

  next();
}

function normalizeStatus(order) {
  const status = order.kitchenStatus || order.orderStatus || "new";

  if (status === "placed" || status === "unconfirmed") return "new";
  if (status === "completed") return "served";

  return status;
}

function minutesSince(value) {
  const date = new Date(value || Date.now()).getTime();

  if (Number.isNaN(date)) return 0;

  return Math.max(0, Math.floor((Date.now() - date) / 60000));
}

function isDeliveryOrder(order) {
  return order.mode === "delivery";
}

function isCashDelivery(order) {
  const method = String(order.paymentMethod || "").toLowerCase();
  const paymentStatus = String(order.paymentStatus || "").toLowerCase();

  return (
    isDeliveryOrder(order) &&
    (
      paymentStatus === "unpaid" ||
      method.includes("cash") ||
      method.includes("cod") ||
      method.includes("pay later") ||
      method.includes("unpaid")
    )
  );
}

function nextAutoStatus(order, settings) {
  if (!settings.autoEnabled) return null;

  const current = normalizeStatus(order);

  if (["cancelled", "served", "completed", "cash_received"].includes(current)) {
    return null;
  }

  const changedAt =
    order.kitchenStatusChangedAt ||
    order.updatedAt ||
    order.createdAt ||
    order.date ||
    new Date().toISOString();

  const elapsed = minutesSince(changedAt);

  if (current === "new" && elapsed >= Number(settings.newToPreparingMinutes || 2)) {
    return "preparing";
  }

  if (current === "preparing" && elapsed >= Number(settings.preparingToReadyMinutes || 8)) {
    return "ready";
  }

  if (isDeliveryOrder(order)) {
    if (current === "ready" && elapsed >= Number(settings.readyToRiderPickedMinutes || 2)) {
      return "rider_picked";
    }

    if (current === "rider_picked" && elapsed >= Number(settings.riderPickedToOnWayMinutes || 2)) {
      return "rider_on_way";
    }

    if (current === "rider_on_way" && elapsed >= Number(settings.riderOnWayToDeliveredMinutes || 20)) {
      return "rider_delivered";
    }

    if (
      current === "rider_delivered" &&
      isCashDelivery(order) &&
      elapsed >= Number(settings.deliveredToCashReceivedMinutes || 3)
    ) {
      return "cash_received";
    }
  }

  if (!isDeliveryOrder(order) && current === "ready") {
    return null;
  }

  return null;
}

function visibleKitchenOrder(order) {
  if (order.paymentStatus === "cancelled" || order.orderStatus === "cancelled") return false;

  const status = normalizeStatus(order);

  return !["completed", "served", "cancelled"].includes(status);
}

function setOrderStatus(order, nextStatus, actor = "kds") {
  const now = new Date().toISOString();

  order.kitchenStatus = nextStatus;
  order.kitchenStatusChangedAt = now;
  order.kitchenStatusChangedBy = actor;
  order.updatedAt = now;

  if (nextStatus === "served") {
    order.orderStatus = "completed";
  } else if (nextStatus === "cash_received") {
    order.paymentStatus = "paid";
    order.paymentMethod = order.paymentMethod || "Cash on Delivery";
    order.orderStatus = "completed";
    order.cashReceivedAt = now;
  } else if (nextStatus === "rider_delivered") {
    order.orderStatus = "served";
  } else if (!["cancelled", "held", "completed"].includes(order.orderStatus)) {
    order.orderStatus = "placed";
  }

  return order;
}

function groupOrders(orders) {
  return orders.reduce((groups, order) => {
    const status = normalizeStatus(order);
    if (!groups[status]) groups[status] = [];
    groups[status].push(order);
    return groups;
  }, {});
}

module.exports = function kdsAutoRoutes({
  getKitchenOrdersForTenant,
  getKdsSettingsRecord,
  saveKdsSettingsRecord,
  saveOrderRecord,
  findOrderForTenant,
  addAuditLog
}) {
  router.get("/settings", tenantOnly, async (req, res) => {
    try {
      const settings = await getKdsSettingsRecord(req.user.tenantId, defaultKdsSettings);
      res.json({ settings });
    } catch (error) {
      console.error("KDS settings error:", error);
      res.status(500).json({ message: "Failed to load KDS settings." });
    }
  });

  router.put("/settings", tenantOnly, async (req, res) => {
    try {
      const settings = {
        ...defaultKdsSettings,
        ...req.body,
        tenantId: req.user.tenantId,
        updatedAt: new Date().toISOString()
      };

      const saved = await saveKdsSettingsRecord(req.user.tenantId, settings);

      res.json({
        message: "KDS settings saved.",
        settings: saved
      });
    } catch (error) {
      console.error("KDS settings save error:", error);
      res.status(500).json({ message: "Failed to save KDS settings." });
    }
  });

  router.patch("/settings", tenantOnly, async (req, res) => {
    try {
      const current = await getKdsSettingsRecord(req.user.tenantId, defaultKdsSettings);

      const settings = {
        ...defaultKdsSettings,
        ...current,
        ...req.body,
        tenantId: req.user.tenantId,
        updatedAt: new Date().toISOString()
      };

      const saved = await saveKdsSettingsRecord(req.user.tenantId, settings);

      res.json({
        message: "KDS settings updated.",
        settings: saved
      });
    } catch (error) {
      console.error("KDS settings update error:", error);
      res.status(500).json({ message: "Failed to update KDS settings." });
    }
  });

  router.get("/board", tenantOnly, async (req, res) => {
    try {
      const [settings, rawOrders] = await Promise.all([
        getKdsSettingsRecord(req.user.tenantId, defaultKdsSettings),
        getKitchenOrdersForTenant(req.user.tenantId)
      ]);

      const orders = rawOrders
        .filter(visibleKitchenOrder)
        .slice(0, 80)
        .map((order) => {
          const status = normalizeStatus(order);
          const previewNextStatus = nextAutoStatus(order, settings);

          return {
            ...order,
            normalizedKitchenStatus: status,
            currentKdsStatus: status,
            nextAutoStatus: previewNextStatus,
            autoReady: Boolean(previewNextStatus),
            kdsElapsedMinutes: minutesSince(
              order.kitchenStatusChangedAt ||
              order.updatedAt ||
              order.createdAt ||
              order.date
            )
          };
        });

      res.json({
        settings,
        orders,
        grouped: groupOrders(orders),
        count: orders.length,
        autoMode: "preview_only",
        message: "KDS board loaded."
      });
    } catch (error) {
      console.error("KDS board error:", error);
      res.status(500).json({ message: "Failed to load KDS board." });
    }
  });

  async function updateStatusHandler(req, res) {
    try {
      const { orderId } = req.params;
      const { kitchenStatus, status } = req.body;

      const nextStatus = kitchenStatus || status;

      if (!allowedStatuses.includes(nextStatus)) {
        return res.status(400).json({ message: "Invalid kitchen status." });
      }

      const order = await findOrderForTenant(req.user.tenantId, orderId);

      if (!order) {
        return res.status(404).json({ message: "Order not found." });
      }

      const before = {
        kitchenStatus: order.kitchenStatus,
        orderStatus: order.orderStatus,
        paymentStatus: order.paymentStatus
      };

      const updated = setOrderStatus(order, nextStatus, req.user.username || "kds-user");
      const saved = await saveOrderRecord(updated);

      await addAuditLog({
        tenantId: req.user.tenantId,
        action: "KDS_STATUS_UPDATED",
        actor: req.user.username,
        details: {
          orderId: saved.id,
          orderNo: saved.orderNo,
          before,
          after: {
            kitchenStatus: saved.kitchenStatus,
            orderStatus: saved.orderStatus,
            paymentStatus: saved.paymentStatus
          }
        }
      });

      res.json({
        message: "KDS status updated.",
        order: saved
      });
    } catch (error) {
      console.error("KDS status update error:", error);
      res.status(500).json({ message: "Failed to update KDS status." });
    }
  }

  router.patch("/orders/:orderId/status", tenantOnly, updateStatusHandler);
  router.patch("/orders/:orderId/kitchen-status", tenantOnly, updateStatusHandler);
  router.patch("/:orderId/status", tenantOnly, updateStatusHandler);
  router.patch("/:orderId/kitchen-status", tenantOnly, updateStatusHandler);

  router.post("/run-auto-once", tenantOnly, async (req, res) => {
    try {
      const settings = await getKdsSettingsRecord(req.user.tenantId, defaultKdsSettings);
      const rawOrders = await getKitchenOrdersForTenant(req.user.tenantId);

      const candidates = rawOrders
        .filter(visibleKitchenOrder)
        .map((order) => ({ order, next: nextAutoStatus(order, settings) }))
        .filter((item) => Boolean(item.next))
        .slice(0, 5);

      const updatedOrders = [];

      for (const item of candidates) {
        const updated = setOrderStatus(item.order, item.next, "system-auto-timer");
        const saved = await saveOrderRecord(updated);
        updatedOrders.push(saved);
      }

      if (updatedOrders.length > 0) {
        await addAuditLog({
          tenantId: req.user.tenantId,
          action: "KDS_AUTO_PROGRESS_BATCH",
          actor: req.user.username || "system-auto-timer",
          details: {
            updated: updatedOrders.length,
            orderIds: updatedOrders.map((order) => order.id)
          }
        });
      }

      res.json({
        message: "KDS auto progress completed.",
        updated: updatedOrders.length,
        orders: updatedOrders
      });
    } catch (error) {
      console.error("KDS auto progress error:", error);
      res.status(500).json({ message: "Failed to run KDS auto progress." });
    }
  });

  return router;
};
